#!/usr/bin/env bash
# Per-app microphone choices for the audio panel.
#
#   mic-apps list                 JSON array of apps that use (or have used) a microphone
#   mic-apps pin <app> <source>   always feed <app> from <source> (a PipeWire source node name)
#   mic-apps unpin <app>          <app> follows the default input again
#   mic-apps enforce              move every recording app that has a pin onto its pinned mic
#
# An app only has a microphone stream while it is listening, so a choice made
# beforehand has nothing to act on. The choice is therefore kept here, in
# audio-mic-pins.json, and applied the moment the app starts recording (the
# panel runs "enforce" whenever a recording stream appears). Apps are known by
# their PipeWire application.name, the same key WirePlumber remembers them by.
set -u

PINS="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/audio-mic-pins.json"
WP_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/wireplumber/stream-properties"
# Not apps: level meters, monitors and test tools. Cornerstone dictation is
# listed like any app; its script reads its pin from the same file.
HIDE='peak|monitor|meter|quickshell|omarchy-|pavucontrol|^pw-record$|^pw-cat$|^parec$|^arecord$|^cs-captest$|^Test Recorder$|^upc\.exe$|^UplayWebCore\.exe$'

pins() { [[ -s $PINS ]] && jq -c 'if type == "object" then . else {} end' "$PINS" 2>/dev/null || echo '{}'; }

save_pins() {
  local tmp
  tmp=$(mktemp "$PINS.XXXXXX") || return 1
  cat >"$tmp" && mv -f "$tmp" "$PINS"
}

# Recording streams right now: [{app, id (node id), serial, source (node name)}]
live() {
  local sources outputs
  sources=$(pactl -f json list sources 2>/dev/null) || sources='[]'
  outputs=$(pactl -f json list source-outputs 2>/dev/null) || outputs='[]'
  jq -c -n --argjson s "$sources" --argjson o "$outputs" --arg hide "$HIDE" '
    ($s | map({key: (.index | tostring), value: .name}) | from_entries) as $names
    | [ $o[]
        | { app: (.properties["application.name"] // ""),
            id: (.properties["object.id"] // ""),
            serial: .index,
            source: ($names[(.source | tostring)] // "") }
        | select(.app != "" and (.app | test($hide; "i") | not))
        # an app recording a monitor is capturing playback, not a microphone
        | select(.source | endswith(".monitor") | not) ]'
}

# Apps WirePlumber has seen record before: one name per line.
known() {
  [[ -r $WP_STATE ]] || return 0
  sed -n 's/^Input\/Audio:application\.name:\(.*\)={.*/\1/p' "$WP_STATE" | sed 's/\\s/ /g'
}

case "${1:-}" in
  list)
    jq -c -n --argjson live "$(live)" --argjson pins "$(pins)" --arg known "$(known)" --arg hide "$HIDE" '
      ($live | group_by(.app) | map({key: .[0].app, value: .[0].source}) | from_entries) as $now
      | ( [$known | split("\n")[] | select(. != "")] + ($pins | keys) + ($now | keys) | unique ) as $apps
      | [ $apps[] | select(test($hide; "i") | not) | . as $a
          | { app: $a, live: ($now | has($a)), source: ($now[$a] // ""), pin: ($pins[$a] // "") } ]
      | sort_by([(.live | not), (.app | ascii_downcase)])'
    ;;
  pin)
    app=${2:-}; src=${3:-}
    [[ -n $app && -n $src ]] || exit 2
    pins | jq --arg a "$app" --arg s "$src" '.[$a] = $s' | save_pins || exit 1
    live | jq -r --arg a "$app" '.[] | select(.app == $a) | .serial' | while read -r serial; do
      pactl move-source-output "$serial" "$src"
    done
    ;;
  unpin)
    app=${2:-}
    [[ -n $app ]] || exit 2
    pins | jq --arg a "$app" 'del(.[$a])' | save_pins || exit 1
    # Clear the stream's target so it follows the default input, and so
    # WirePlumber forgets the device it remembered for this app.
    live | jq -r --arg a "$app" '.[] | select(.app == $a) | .id' | while read -r id; do
      [[ $id =~ ^[0-9]+$ ]] || continue
      pw-metadata -n default -- "$id" target.object -1 Spa:Id >/dev/null
      pw-metadata -n default -- "$id" target.node -1 Spa:Id >/dev/null
    done
    ;;
  enforce)
    p=$(pins)
    [[ $p == '{}' ]] && exit 0
    present=$(pactl -f json list sources 2>/dev/null | jq -c 'map(.name)') || exit 0
    live | jq -r --argjson p "$p" --argjson have "$present" '
      .[] | select($p[.app] != null and $p[.app] != .source)
          | select($p[.app] as $want | $have | index($want))   # unplugged mic: leave the app where it is
          | "\(.serial)\t\($p[.app])"' | while IFS=$'\t' read -r serial src; do
      pactl move-source-output "$serial" "$src"
    done
    ;;
  *) echo "usage: mic-apps list | pin <app> <source> | unpin <app> | enforce" >&2; exit 2 ;;
esac
