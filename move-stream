#!/usr/bin/env bash
# Send one app's sound to one output device.
#   move-stream <stream node id> <sink or source node name> [input]
# The panel knows a stream by its PipeWire node id; pactl moves it by the node's serial number, which is read here.
# WirePlumber remembers the choice per app, as it does when any other mixer moves a stream.
set -u
id=${1:-}; sink=${2:-}
[[ $id =~ ^[0-9]+$ ]] || exit 2
[ -n "$sink" ] || exit 2
serial=$(wpctl inspect "$id" 2>/dev/null | sed -n 's/.*object\.serial = "\([0-9]\+\)".*/\1/p' | head -1)
[ -n "$serial" ] || exit 3
# a third argument "input" moves a recording app to a microphone instead
if [ "${3:-}" = input ]; then
  # "@default" un-pins: clear the stream's target so it follows the default input again (and WirePlumber forgets the pin).
  if [ "$sink" = "@default" ]; then
    pw-metadata -n default -- "$id" target.object -1 Spa:Id >/dev/null
    exec pw-metadata -n default -- "$id" target.node -1 Spa:Id >/dev/null
  fi
  exec pactl move-source-output "$serial" "$sink"
fi
exec pactl move-sink-input "$serial" "$sink"
